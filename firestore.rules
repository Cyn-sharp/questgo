rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return verified() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if verified() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if false;
    }

    match /quests/{questId} {
      allow read: if verified();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}